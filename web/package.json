{
  "name": "trolley-watch",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "data": "node scripts/copy-data.mjs",
    "dev": "npm run data && vite",
    "build": "npm run data && tsc --noEmit && vite build && node scripts/budget.mjs",
    "preview": "vite preview",
    "test": "npm run data && vitest run",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src scripts",
    "lint": "prettier --check src scripts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "^5.2.0",
    "@fontsource/ibm-plex-sans": "^5.2.0",
    "@fontsource/ibm-plex-sans-condensed": "^5.2.0",
    "@fontsource/ibm-plex-serif": "^5.3.0",
    "@types/node": "^22.20.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.7.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "vite": "^6.3.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=22"
  }
}
